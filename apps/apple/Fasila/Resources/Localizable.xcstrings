    "estimated.highLatitude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this latitude twilight does not fully disappear, so Fajr and Isha are estimated with the high-latitude rule chosen in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا العرض الجغرافي لا يغيب الشفق تمامًا، لذا يُقدَّر وقتا الفجر والعشاء بقاعدة خطوط العرض العليا المختارة في الإعدادات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette latitude, le crépuscule ne disparaît pas complètement : Fajr et Isha sont estimés selon la règle des hautes latitudes choisie dans les réglages."
          }
        }
      }
    },
    "estimated.polar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not rise or set here today. Times are taken from the nearest latitude where it does."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشرق الشمس أو لا تغرب هنا اليوم. الأوقات مأخوذة من أقرب خط عرض تحدث فيه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soleil ne se lève ou ne se couche pas ici aujourd'hui. Les horaires proviennent de la latitude la plus proche où il le fait."
          }
        }
      }
    },
