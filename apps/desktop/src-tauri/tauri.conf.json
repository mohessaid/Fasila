{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fasila",
  "version": "0.1.0",
  "identifier": "app.fasila.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fasila",
        "width": 1120,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Lifestyle",
    "shortDescription": "Prayer times and a life scheduled around them",
    "linux": { "deb": { "depends": [] } }
  }
}
